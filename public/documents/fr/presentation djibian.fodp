   </draw:page>
   <draw:page draw:name="page11" draw:style-name="dp3" draw:master-page-name="Standard" presentation:presentation-page-layout-name="AL2T0">
    <draw:frame presentation:style-name="pr6" draw:text-style-name="P13" draw:layer="layout" svg:width="25.199cm" svg:height="2.629cm" svg:x="1.4cm" svg:y="0.628cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">OpenPGP</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr13" draw:text-style-name="P40" draw:layer="layout" svg:width="25.199cm" svg:height="10.696cm" svg:x="1.4cm" svg:y="2.902cm" presentation:class="subtitle" presentation:user-transformed="true">
     <draw:text-box>
      <text:list text:style-name="L5">
       <text:list-item>
        <text:p text:style-name="P37"><text:span text:style-name="T14">Signature, Chiffrement, Authentification</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P37"><text:span text:style-name="T14">Confiance décentralisée (Web of Trust)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P38"><text:span text:style-name="T20">Technologie éprouvée (1991), ouverte (depuis 1996),</text:span></text:p>
       </text:list-item>
      </text:list>
      <text:p text:style-name="P38"><text:span text:style-name="T20"><text:tab/></text:span><text:span text:style-name="T20">en constante évolution (8 RFC + many IETF drafts)</text:span></text:p>
      <text:list text:continue-numbering="true" text:style-name="L5">
       <text:list-item>
        <text:p text:style-name="P38"><text:span text:style-name="T14">Interopérable (courriel, ssh, git, documents, paiements)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P39"><text:span text:style-name="T30">Outil ultime pour </text:span><text:span text:style-name="T31">contrer la surveillance de masse</text:span><text:span text:style-name="T30"> et </text:span><text:span text:style-name="T32">construire des réseaux qui respectent nos vies privées</text:span><text:span text:style-name="T30">.</text:span></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P10" draw:layer="layout" svg:width="3.397cm" svg:height="1.187cm" svg:x="23.603cm" svg:y="14.563cm">
     <draw:text-box>
      <text:p text:style-name="P9"><text:span text:style-name="T11"><text:page-number>&lt;numéro&gt;</text:page-number></text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P11" draw:layer="layout" svg:width="1.5cm" svg:height="1.123cm" svg:x="26.5cm" svg:y="14.563cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T11">/</text:span><text:span text:style-name="T11"><text:page-count>15</text:page-count></text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr5" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="11" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P12" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page12" draw:style-name="dp3" draw:master-page-name="Standard" presentation:presentation-page-layout-name="AL2T0">
    <draw:frame presentation:style-name="pr6" draw:text-style-name="P13" draw:layer="layout" svg:width="25.199cm" svg:height="2.629cm" svg:x="1.4cm" svg:y="0.628cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">Djibian</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr14" draw:text-style-name="P22" draw:layer="layout" svg:width="25.199cm" svg:height="9.134cm" svg:x="1.4cm" svg:y="3.685cm" presentation:class="subtitle" presentation:user-transformed="true">
     <draw:text-box>
      <text:list text:style-name="L5">
       <text:list-item>
        <text:p>Système GNU/Linux</text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P41">Fait par et pour des <text:span text:style-name="T29">humains qui se respectent</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P41">Composé à 99 % de logiciels libres :</text:p>
        <text:p><text:span text:style-name="T29">communs auditables et réparables</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P41"><text:span text:style-name="T33">À la pointe</text:span><text:span text:style-name="T34"> de l’usage d’</text:span><text:span text:style-name="T33">OpenPGP</text:span><text:span text:style-name="T34">,</text:span></text:p>
        <text:p><text:span text:style-name="T34">et notamment du </text:span><text:span text:style-name="T33">dji</text:span><text:span text:style-name="T26"> (Ɉ)</text:span></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P10" draw:layer="layout" svg:width="3.397cm" svg:height="1.187cm" svg:x="23.603cm" svg:y="14.563cm">
     <draw:text-box>
      <text:p text:style-name="P9"><text:span text:style-name="T11"><text:page-number>&lt;numéro&gt;</text:page-number></text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P11" draw:layer="layout" svg:width="1.5cm" svg:height="1.123cm" svg:x="26.5cm" svg:y="14.563cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T11">/</text:span><text:span text:style-name="T11"><text:page-count>15</text:page-count></text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr5" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="12" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P12" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page13" draw:style-name="dp3" draw:master-page-name="Standard" presentation:presentation-page-layout-name="AL2T0">
    <draw:frame presentation:style-name="pr6" draw:text-style-name="P13" draw:layer="layout" svg:width="25.199cm" svg:height="2.629cm" svg:x="1.4cm" svg:y="0.628cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">Bilan</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr15" draw:text-style-name="P43" draw:layer="layout" svg:width="24.5cm" svg:height="10.507cm" svg:x="2cm" svg:y="2.999cm" presentation:class="subtitle" presentation:user-transformed="true">
     <draw:text-box>
      <text:list text:style-name="L5">
       <text:list-item>
        <text:p text:style-name="P42"><text:span text:style-name="T15">Ré-appropriation de l’outil</text:span><text:span text:style-name="T14"> (« Monnaie libre »)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P42"><text:span text:style-name="T14">Cadre structuré (Statuts, RI, Siret, etc) : </text:span><text:span text:style-name="T15">foopgp.org</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P42"><text:span text:style-name="T14">Outillage </text:span><text:span text:style-name="T15">posé et opérationnel</text:span><text:span text:style-name="T14"> (NextCloud, git, etc)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P42"><text:span text:style-name="T14">Identité numérique décentralisée </text:span><text:span text:style-name="T15">OpenPGP ID</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P42"><text:span text:style-name="T14">Véhicule intégrateur et catalyseur : </text:span><text:span text:style-name="T35">djibian</text:span><text:span text:style-name="T14"> </text:span></text:p>
        <text:list>
         <text:list-item>
          <text:list>
           <text:list-item>
            <text:list>
             <text:list-item>
              <text:list>
               <text:list-item>
                <text:p text:style-name="P42"><text:span text:style-name="T32">Réservations </text:span><text:span text:style-name="T36">et</text:span><text:span text:style-name="T32"> créations</text:span><text:span text:style-name="T32"><text:line-break/></text:span><text:span text:style-name="T32"><text:tab/></text:span><text:span text:style-name="T32"> </text:span><text:span text:style-name="T32"><text:tab/></text:span><text:span text:style-name="T32"> </text:span><text:span text:style-name="T36">des</text:span><text:span text:style-name="T32"> premiers djis </text:span><text:span text:style-name="T36">(Ɉ)</text:span></text:p>
               </text:list-item>
              </text:list>
             </text:list-item>
            </text:list>
           </text:list-item>
          </text:list>
         </text:list-item>
        </text:list>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P10" draw:layer="layout" svg:width="3.397cm" svg:height="1.187cm" svg:x="23.603cm" svg:y="14.563cm">
     <draw:text-box>
      <text:p text:style-name="P9"><text:span text:style-name="T11"><text:page-number>&lt;numéro&gt;</text:page-number></text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P11" draw:layer="layout" svg:width="1.5cm" svg:height="1.123cm" svg:x="26.5cm" svg:y="14.563cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T11">/</text:span><text:span text:style-name="T11"><text:page-count>15</text:page-count></text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr5" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="13" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P12" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page14" draw:style-name="dp3" draw:master-page-name="Standard" presentation:presentation-page-layout-name="AL2T0">
    <draw:frame presentation:style-name="pr6" draw:text-style-name="P13" draw:layer="layout" svg:width="25.199cm" svg:height="2.629cm" svg:x="1.4cm" svg:y="0.628cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">Objectifs</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr16" draw:text-style-name="P46" draw:layer="layout" svg:width="25.199cm" svg:height="9.241cm" svg:x="1.4cm" svg:y="3.629cm" presentation:class="subtitle" presentation:user-transformed="true">
     <draw:text-box>
      <text:list text:style-name="L5">
       <text:list-item>
        <text:p text:style-name="P44"><text:span text:style-name="T15">Échanger</text:span><text:span text:style-name="T14"> ses </text:span><text:span text:style-name="T15">djis</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P44"><text:span text:style-name="T14">Améliorer la </text:span><text:span text:style-name="T15">structure</text:span><text:span text:style-name="T14"> (SCOP)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P45"><text:span text:style-name="T14">Améliorer la </text:span><text:span text:style-name="T15">qualité des produits</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P45"><text:span text:style-name="T14">Accompagner la </text:span><text:span text:style-name="T15">croissance des adhésions</text:span><text:span text:style-name="T14"> (&gt; 1M)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P45"><text:span text:style-name="T20">Accompagner la </text:span><text:span text:style-name="T37">montée en valeur du dji</text:span><text:span text:style-name="T20"> (1 Ɉ &gt; 1k€)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P44"><text:span text:style-name="T33">Nous libérer</text:span><text:span text:style-name="T34"> à 90 % du chiffre d’affaire</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P44"><text:span text:style-name="T33">des GAFAMPX</text:span><text:span text:style-name="T34"> d’aujourd’hui.</text:span></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P10" draw:layer="layout" svg:width="3.397cm" svg:height="1.187cm" svg:x="23.603cm" svg:y="14.563cm">
     <draw:text-box>
      <text:p text:style-name="P9"><text:span text:style-name="T11"><text:page-number>&lt;numéro&gt;</text:page-number></text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P11" draw:layer="layout" svg:width="1.5cm" svg:height="1.123cm" svg:x="26.5cm" svg:y="14.563cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T11">/</text:span><text:span text:style-name="T11"><text:page-count>15</text:page-count></text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr5" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="14" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P12" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page15" draw:style-name="dp3" draw:master-page-name="Standard" presentation:presentation-page-layout-name="AL2T0">
    <draw:frame presentation:style-name="pr17" draw:text-style-name="P13" draw:layer="layout" svg:width="25.199cm" svg:height="1.993cm" svg:x="1.5cm" svg:y="1cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">Merci pour votre attention</text:span></text:p>
     </draw:text-box>
    </draw:frame>
