   <draw:page draw:name="page3" draw:style-name="dp3" draw:master-page-name="Standard" presentation:presentation-page-layout-name="AL2T0">
    <draw:frame presentation:style-name="pr6" draw:text-style-name="P13" draw:layer="layout" svg:width="25.199cm" svg:height="2.629cm" svg:x="1.4cm" svg:y="0.628cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">D’où tu parles ?</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr7" draw:text-style-name="P15" draw:layer="layout" svg:width="25.199cm" svg:height="9.134cm" svg:x="1.4cm" svg:y="3.685cm" presentation:class="subtitle" presentation:user-transformed="true">
     <draw:text-box>
      <text:p>Né en 1980 à Paris</text:p>
      <text:p>Élevé dans les hautes-alpes</text:p>
      <text:p>« atypique »</text:p>
      <text:p>Ingénieur non diplômé</text:p>
      <text:p>Sensibilité exacerbée</text:p>
      <text:p>Curieux, inventif, aventurier.</text:p>
      <text:p><text:a xlink:href="https://domesticserver.org/myresume/" xlink:type="simple">https://domesticserver.org/myresume/</text:a></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P10" draw:layer="layout" svg:width="3.397cm" svg:height="1.187cm" svg:x="23.603cm" svg:y="14.564cm">
     <draw:text-box>
      <text:p text:style-name="P9"><text:span text:style-name="T11"><text:page-number>&lt;numéro&gt;</text:page-number></text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P11" draw:layer="layout" svg:width="1.5cm" svg:height="1.123cm" svg:x="26.5cm" svg:y="14.564cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T11">/</text:span><text:span text:style-name="T11"><text:page-count>15</text:page-count></text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr5" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="3" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P12" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page4" draw:style-name="dp3" draw:master-page-name="Standard" presentation:presentation-page-layout-name="AL2T0">
    <draw:frame presentation:style-name="pr6" draw:text-style-name="P13" draw:layer="layout" svg:width="25.199cm" svg:height="2.629cm" svg:x="1.4cm" svg:y="0.628cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">Vision</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr8" draw:text-style-name="P18" draw:layer="layout" svg:width="25.199cm" svg:height="9.409cm" svg:x="2.7cm" svg:y="3.257cm" presentation:class="subtitle" presentation:user-transformed="true">
     <draw:text-box>
      <text:list text:style-name="L4">
       <text:list-item>
        <text:p text:style-name="P16"><text:span text:style-name="T13">Ne pas subir</text:span><text:span text:style-name="T14"> (la décroissance),</text:span></text:p>
       </text:list-item>
      </text:list>
      <text:list text:style-name="L5">
       <text:list-item>
        <text:p text:style-name="P16"><text:span text:style-name="T14">Mais </text:span><text:span text:style-name="T15">reprendre de la maîtrise</text:span><text:span text:style-name="T14"> (de notre bonheur).</text:span></text:p>
       </text:list-item>
      </text:list>
      <text:list text:style-name="L4">
       <text:list-item>
        <text:p text:style-name="P17"><text:span text:style-name="T14">Moins d’</text:span><text:span text:style-name="T13">individualisme</text:span><text:span text:style-name="T14">, de </text:span><text:span text:style-name="T13">consommation</text:span><text:span text:style-name="T14">,</text:span></text:p>
       </text:list-item>
      </text:list>
      <text:list text:style-name="L5">
       <text:list-item>
        <text:p text:style-name="P16"><text:span text:style-name="T14">Plus de </text:span><text:span text:style-name="T15">sens</text:span><text:span text:style-name="T14">, de </text:span><text:span text:style-name="T15">joie de vivre</text:span><text:span text:style-name="T14">, de </text:span><text:span text:style-name="T15">paix</text:span><text:span text:style-name="T14">.</text:span></text:p>
       </text:list-item>
      </text:list>
      <text:list text:style-name="L4">
       <text:list-item>
        <text:p text:style-name="P17"><text:span text:style-name="T14">Moins d’</text:span><text:span text:style-name="T13">écrans</text:span><text:span text:style-name="T14">, de </text:span><text:span text:style-name="T13">gadgets numériques</text:span><text:span text:style-name="T14">,</text:span></text:p>
       </text:list-item>
      </text:list>
      <text:list text:style-name="L5">
       <text:list-item>
        <text:p text:style-name="P16"><text:span text:style-name="T14">Plus d’</text:span><text:span text:style-name="T15">air pur</text:span><text:span text:style-name="T14">, de </text:span><text:span text:style-name="T15">repas partagés</text:span><text:span text:style-name="T14">.</text:span></text:p>
       </text:list-item>
      </text:list>
      <text:list text:style-name="L4">
       <text:list-item>
        <text:p text:style-name="P17"><text:span text:style-name="T14">Moins de </text:span><text:span text:style-name="T13">magouilles</text:span><text:span text:style-name="T14">, de </text:span><text:span text:style-name="T13">coercitions</text:span><text:span text:style-name="T14">,</text:span></text:p>
       </text:list-item>
      </text:list>
      <text:list text:style-name="L5">
       <text:list-item>
        <text:p text:style-name="P16"><text:span text:style-name="T14">Plus de </text:span><text:span text:style-name="T15">transparence</text:span><text:span text:style-name="T14">*,</text:span><text:span text:style-name="T16"> d’</text:span><text:span text:style-name="T15">équité</text:span><text:span text:style-name="T14">.</text:span></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P10" draw:layer="layout" svg:width="3.397cm" svg:height="1.187cm" svg:x="23.603cm" svg:y="14.563cm">
     <draw:text-box>
      <text:p text:style-name="P9"><text:span text:style-name="T11"><text:page-number>&lt;numéro&gt;</text:page-number></text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P11" draw:layer="layout" svg:width="1.5cm" svg:height="1.123cm" svg:x="26.5cm" svg:y="14.563cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T11">/</text:span><text:span text:style-name="T11"><text:page-count>15</text:page-count></text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr6" draw:text-style-name="P20" draw:layer="layout" svg:width="8cm" svg:height="2cm" svg:x="10.5cm" svg:y="12.5cm">
     <draw:text-box>
      <text:p text:style-name="P19"><text:span text:style-name="T17"><text:s/>(* : dans l’espace publique)</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr5" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="4" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P12" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page5" draw:style-name="dp3" draw:master-page-name="Standard" presentation:presentation-page-layout-name="AL2T0">
    <draw:frame presentation:style-name="pr6" draw:text-style-name="P13" draw:layer="layout" svg:width="25.199cm" svg:height="2.629cm" svg:x="1.4cm" svg:y="0.628cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">Dates clés</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr9" draw:text-style-name="P22" draw:layer="layout" svg:width="25.199cm" svg:height="9.134cm" svg:x="1.4cm" svg:y="3.685cm" presentation:class="subtitle" presentation:user-transformed="true">
     <draw:text-box>
      <text:list text:style-name="L1">
       <text:list-item>
        <text:p text:style-name="P21"><text:span text:style-name="T18">Automne 2008 : crise des subprimes</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P21"><text:span text:style-name="T18">Janvier 2009 : publication du code « bitcoin »</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P21"><text:span text:style-name="T18">2009 &amp; 2010 : </text:span><text:span text:style-name="T18"><text:a xlink:href="https://creationmonetaire.info/" xlink:type="simple">creationmonetaire.info</text:a></text:span><text:span text:style-name="T18"><text:s/>&amp; TRM (S. Laborde)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P21"><text:span text:style-name="T18">Janvier 2011 : projet OpenUDC (J.J. Brucker)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P21"><text:span text:style-name="T18">5 février 2011 : naissance de « la monnaie libre » (de dette)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P21"><text:span text:style-name="T18">Avril 2014 : ucoin/duniter (C. Moreau)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P21"><text:span text:style-name="T18">8 mars 2017 : naissance June (</text:span><text:span text:style-name="T18"><text:a xlink:href="https://monnaie-libre.fr/" xlink:type="simple">monnaie-libre.fr</text:a></text:span><text:span text:style-name="T18">)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P21"><text:span text:style-name="T18">Avril 2023 : Association des amis d’OpenPGP (</text:span><text:span text:style-name="T18"><text:a xlink:href="https://foopgp.org/" xlink:type="simple">foopgp.org</text:a></text:span><text:span text:style-name="T18">)</text:span></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P10" draw:layer="layout" svg:width="3.397cm" svg:height="1.187cm" svg:x="23.603cm" svg:y="14.564cm">
     <draw:text-box>
      <text:p text:style-name="P9"><text:span text:style-name="T11"><text:page-number>&lt;numéro&gt;</text:page-number></text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P11" draw:layer="layout" svg:width="1.5cm" svg:height="1.123cm" svg:x="26.5cm" svg:y="14.564cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T11">/</text:span><text:span text:style-name="T11"><text:page-count>15</text:page-count></text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr5" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="5" presentation:class="page"/>
     <draw:frame presentation:style-name="pr5" draw:text-style-name="P12" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page6" draw:style-name="dp3" draw:master-page-name="Standard" presentation:presentation-page-layout-name="AL3T3">
    <draw:frame presentation:style-name="pr6" draw:text-style-name="P13" draw:layer="layout" svg:width="25.199cm" svg:height="2.629cm" svg:x="1.4cm" svg:y="0.628cm" presentation:class="title">
     <draw:text-box>
      <text:p><text:span text:style-name="T12">Dettes</text:span></text:p>
