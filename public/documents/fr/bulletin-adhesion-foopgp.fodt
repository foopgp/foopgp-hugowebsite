    </draw:frame><text:span text:style-name="T1"><text:tab/></text:span><text:span text:style-name="T2">f</text:span><text:span text:style-name="T3">oO</text:span><text:span text:style-name="T2">pgp <text:s text:c="2"/></text:span><text:span text:style-name="T4">(Friends of OpenPGP)</text:span></text:p>
   <text:p text:style-name="P2">Association des amis d’OpenPGP</text:p>
   <text:p text:style-name="P3"/>
   <text:p text:style-name="P4">Association foopgp</text:p>
   <text:p text:style-name="P5">75, Impasse Serre des Isnards</text:p>
   <text:p text:style-name="P6"><text:tab/>F-05000 <text:s/>PELLEAUTIER</text:p>
   <text:p text:style-name="P5"/>
   <text:p text:style-name="P5">Association loi de 1901 déclarée le 3 avril 2023 à la préfecture des Hautes-Alpes</text:p>
   <text:p text:style-name="P6">Publication au J.O.A.F.E. du 11 avril 2023 - RNA : W052008166</text:p>
   <text:p text:style-name="P7"/>
   <text:p text:style-name="P7"/>
   <text:p text:style-name="P8">Bulletin d’adhésion</text:p>
   <text:p text:style-name="P9">(conserv<text:span text:style-name="T5">é</text:span> par l’association)</text:p>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P11"><text:span text:style-name="T6">État-civil</text:span> :</text:p>
   <text:p text:style-name="P12"/>
   <text:list text:style-name="L1">
    <text:list-item>
     <text:p text:style-name="P13">Date de naissance : <draw:control text:anchor-type="as-char" draw:z-index="4" draw:name="Contrôle 4" draw:style-name="gr1" draw:text-style-name="P14" svg:width="6.095cm" svg:height="0.389cm" draw:control="control4"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P10"/>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-item>
     <text:p text:style-name="P15">Nom de naissance : <draw:control text:anchor-type="as-char" draw:z-index="1" draw:name="Contrôle 1" draw:style-name="gr2" draw:text-style-name="P16" svg:width="10.157cm" svg:height="0.415cm" draw:control="control1"/></text:p>
     <text:p text:style-name="P13"/>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P15">Prénom<text:span text:style-name="T7">(</text:span>s<text:span text:style-name="T7">)</text:span> de naissance : <draw:control text:anchor-type="as-char" draw:z-index="2" draw:name="Contrôle 2" draw:style-name="gr2" draw:text-style-name="P16" svg:width="12.195cm" svg:height="0.415cm" draw:control="control2"/></text:p>
     <text:p text:style-name="P13"/>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P15">Lieu de naissance : <draw:control text:anchor-type="as-char" draw:z-index="3" draw:name="Contrôle 3" draw:style-name="gr2" draw:text-style-name="P16" svg:width="9.478cm" svg:height="0.415cm" draw:control="control3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P17"><text:span text:style-name="T8">Note : L</text:span><text:span text:style-name="T9">es informations </text:span><text:span text:style-name="T8">d’état-civil </text:span><text:span text:style-name="T9">servent à générer un identifiant unique. Elles ne seront jamais publiées. Si vous ne voulez pas nous les transmettre, vous pouvez vous même générer cet identifiant en utilisant notre outil en ligne : </text:span><text:a xlink:type="simple" xlink:href="https://foopgp.org/udid/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="T9">https://foopgp.org/udid/</text:span></text:a><text:span text:style-name="T9"> puis l’indiquer ci-dessous :</text:span></text:p>
   <text:p text:style-name="P18"/>
   <text:p text:style-name="P19"><text:span text:style-name="T10"><text:tab/></text:span><text:span text:style-name="T11">Your Uni</text:span><text:span text:style-name="T12">versal</text:span><text:span text:style-name="T11"> Identifier (UDID4):</text:span> <draw:control text:anchor-type="as-char" draw:z-index="5" draw:name="Contrôle 5" draw:style-name="gr2" draw:text-style-name="P16" svg:width="9.478cm" svg:height="0.415cm" draw:control="control5"/></text:p>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P20"><text:span text:style-name="T13">Comment souhaitez-vous </text:span><text:span text:style-name="T14">être identifié (</text:span><text:span text:style-name="T15">nom ou pseudonyme</text:span><text:span text:style-name="T14">) : </text:span><text:span text:style-name="T14"><draw:control text:anchor-type="as-char" draw:z-index="6" draw:name="Contrôle 6" draw:style-name="gr2" draw:text-style-name="P16" svg:width="3.604cm" svg:height="0.415cm" draw:control="control6"/></text:span></text:p>
   <text:p text:style-name="P20"/>
   <text:p text:style-name="P21"><text:span text:style-name="T16">C</text:span><text:span text:style-name="T17">ourriel</text:span> <text:span text:style-name="T18">destiné à être publié sur des serveurs de clés publiques OpenPGP </text:span><text:span text:style-name="T14">: </text:span><draw:control text:anchor-type="as-char" svg:y="-0.328cm" draw:z-index="7" draw:name="Contrôle 7" draw:style-name="gr3" draw:text-style-name="P16" svg:width="5.407cm" svg:height="0.415cm" draw:control="control7"/></text:p>
   <text:p text:style-name="P21"/>
   <text:p text:style-name="P21"><text:span text:style-name="T18">Si vous n’avez pas (encore) de courriel (publique) destiné aux communications sécurisé</text:span><text:span text:style-name="T19">es</text:span><text:span text:style-name="T18"> OpenPGP,<text:line-break/><text:tab/><text:tab/><text:tab/><text:tab/><text:tab/><text:tab/><text:tab/> <text:s text:c="5"/></text:span><text:span text:style-name="T20">autre courriel</text:span><text:span text:style-name="T18"> </text:span>: <draw:control text:anchor-type="as-char" svg:y="-0.328cm" draw:z-index="15" draw:name="Contrôle 11" draw:style-name="gr3" draw:text-style-name="P16" svg:width="5.596cm" svg:height="0.415cm" draw:control="control15"/><text:s/></text:p>
   <text:p text:style-name="P21"/>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P22"><text:span text:style-name="T21">Montant </text:span><text:span text:style-name="T22">de la c</text:span><text:span text:style-name="T23">otisation </text:span><text:span text:style-name="T24">engendrant l’attribution de jetons « </text:span><text:span text:style-name="T22">djis » (</text:span>Ɉ<text:span text:style-name="T25">) </text:span><text:span text:style-name="T21">: </text:span><text:span text:style-name="T21"><draw:control text:anchor-type="as-char" draw:z-index="8" draw:name="Contrôle 10" draw:style-name="gr2" draw:text-style-name="P16" svg:width="3.432cm" svg:height="0.415cm" draw:control="control8"/></text:span><text:span text:style-name="T21"><text:s/></text:span><text:span text:style-name="T26">(minimum : 1 €)</text:span></text:p>
   <text:p text:style-name="P23"/>
   <text:p text:style-name="Horizontal_20_Line"/>
   <text:p text:style-name="P24"/>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P10">L’adhérent reconnaît avoir pris connaissance de <text:a xlink:type="simple" xlink:href="https://foopgp.org/fr/about/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link">l’objet associatif,</text:a> des <text:a xlink:type="simple" xlink:href="https://foopgp.org/fr/about/status/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link">statuts</text:a> et du <text:a xlink:type="simple" xlink:href="https://foopgp.org/fr/about/rules-of-procedures/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link">règlement intérieur</text:a>, et déclare vouloir adhérer à l’association Friends of OpenPGP (foopgp).</text:p>
   <text:p text:style-name="P25"/>
   <text:p text:style-name="P26"><draw:control text:anchor-type="as-char" draw:z-index="9" draw:name="Contrôle 12" draw:style-name="gr4" draw:text-style-name="P14" svg:width="0.361cm" svg:height="0.304cm" draw:control="control9"/><text:s/><text:span text:style-name="T27">J&apos;accepte par la présente que </text:span><text:span text:style-name="T28">mon nom (ou pseudonyme)</text:span><text:span text:style-name="T27"> puisse être cité dans les publications de l’association (site Internet, etc.).</text:span></text:p>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P27"><text:span text:style-name="T29"><draw:control text:anchor-type="as-char" draw:z-index="10" draw:name="Contrôle 13" draw:style-name="gr4" draw:text-style-name="P14" svg:width="0.361cm" svg:height="0.304cm" draw:control="control10"/></text:span><text:span text:style-name="T29"><text:s/>J&apos;accepte par la présente que les photos sur lesquelles je figure puissent être utilisées uniquement par l&apos;association pour les besoins de son objet. Les photos pourront être publiées par exemple sur le site Internet </text:span><text:span text:style-name="T30">https://foopgpg.org</text:span><text:span text:style-name="T29">. En aucun cas, l’association ne cédera les photos visées à des tiers.</text:span></text:p>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P28"/>
   <text:p text:style-name="P23">Fait à <text:s/><draw:control text:anchor-type="as-char" draw:z-index="11" draw:name="Contrôle 14" draw:style-name="gr2" draw:text-style-name="P16" svg:width="10.563cm" svg:height="0.415cm" draw:control="control11"/><text:s text:c="2"/>le <text:s/><draw:control text:anchor-type="as-char" draw:z-index="12" draw:name="Contrôle 15" draw:style-name="gr1" draw:text-style-name="P14" svg:width="4cm" svg:height="0.389cm" draw:control="control12"/></text:p>
   <text:p text:style-name="P10"><draw:control text:anchor-type="paragraph" draw:z-index="13" draw:name="Contrôle 16" draw:style-name="gr5" draw:text-style-name="P29" svg:width="12.662cm" svg:height="1.287cm" svg:x="4.336cm" svg:y="0.367cm" draw:control="control13"/></text:p>
   <text:p text:style-name="P10"><text:span text:style-name="T31">Signature (de l’</text:span>adhérent<text:span text:style-name="T31">) :</text:span></text:p>
   <text:p text:style-name="P28"/>
   <text:p text:style-name="P30"><text:span text:style-name="T32">(ou bien cochez cette case : </text:span><draw:control text:anchor-type="as-char" draw:z-index="14" draw:name="Contrôle 17" draw:style-name="gr4" draw:text-style-name="P14" svg:width="0.361cm" svg:height="0.304cm" draw:control="control14"/><text:s/><text:span text:style-name="T32">)</text:span></text:p>
   <text:p text:style-name="P31"/>
   <text:p text:style-name="P31"/>
   <text:p text:style-name="Horizontal_20_Line"/>
   <text:p text:style-name="P31"/>
   <text:p text:style-name="P32"><text:span text:style-name="T33">Les champs </text:span><text:span text:style-name="T34">« </text:span><text:span text:style-name="T35">UDID4</text:span><text:span text:style-name="T36"> », « </text:span><text:span text:style-name="T37">nom ou pseudonyme</text:span><text:span text:style-name="T38"> », </text:span><text:span text:style-name="T36">et « </text:span><text:span text:style-name="T35">Courriel </text:span><text:span text:style-name="T36">» (pour OpenPGP), </text:span><text:span text:style-name="T39">sont obligatoires et seront </text:span><text:span text:style-name="T40">accessibles</text:span><text:span text:style-name="T39"> </text:span><text:span text:style-name="T40">pour</text:span><text:span text:style-name="T39"> l’ensemble des adhérents. Les autres champs resteront strictement confidentiels, et l&apos;adhérent dispose d’un droit d’accès, de rectification et de suppression de ces informations ; c</text:span><text:span text:style-name="T41">onformément aux dispositions de la l</text:span><text:span text:style-name="T42">oi 78-17 du 6 janvier 1978 modifiée relative à l&apos;informatique, aux fichiers et aux libertés</text:span><text:span text:style-name="T41">, et avec du </text:span><text:span text:style-name="T42">Règlement Général de Protection des Données</text:span><text:span text:style-name="T41"> (RGPD). </text:span></text:p>
  </office:text>
 </office:body>
</office:document>